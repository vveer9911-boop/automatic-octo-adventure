# =============================================================================
# Screen Time Wallet APK — Environment Variables Template (.env.example)
# Copy this file to .env.local and fill in your own keys.
# Never commit .env.local or live secret keys to version control.
# =============================================================================

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 1. Database & Auth (Supabase Postgres with Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Session signing secret (generate with: openssl rand -hex 32)
AUTH_SESSION_SECRET=

# 2. Payments (Stripe Checkout & Customer Portal — use sk_test_ / pk_test_ until deploy)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# 3. Free-Tier Native Ads (Google AdMob Official Android Unit IDs)
# Default values in dev use Google's official public test ad unit IDs:
# ca-app-pub-3940256099942544/2247696110 (Native Advanced Test ID)
NEXT_PUBLIC_ADMOB_APP_ID=
NEXT_PUBLIC_ADMOB_FOCUS_TOP_PILL_UNIT_ID=
NEXT_PUBLIC_ADMOB_POST_SESSION_CARD_UNIT_ID=
NEXT_PUBLIC_ADMOB_DASHBOARD_NATIVE_UNIT_ID=

# 4. Transactional Email (Resend)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# 5. Background Jobs Cron Secret
CRON_SECRET=
